// ChezCat's selected original C-cat artwork and executable metadata.
// Regenerate the shipped .res and x64 .o with tools/build_icon_resources.py.
LANGUAGE 9, 1

101 ICON "assets/chezcat.ico"

1 VERSIONINFO
FILEVERSION 0,56,0,0
PRODUCTVERSION 0,56,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ChezCat web browser\0"
            VALUE "FileVersion", "0.56\0"
            VALUE "InternalName", "ChezCat\0"
            VALUE "OriginalFilename", "ChezCat.exe\0"
            VALUE "ProductName", "ChezCat\0"
            VALUE "ProductVersion", "0.56\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

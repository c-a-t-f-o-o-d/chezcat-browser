    {
      "id": "object-is-identity-and-no-conversion",
      "source": "let o={valueOf(){throw 'coercion';},toString(){throw 'coercion';}},f=function(){},s=Symbol('s');test.record(Object.is(o,o));test.record(Object.is(o,{}));test.record(Object.is(o,1));test.record(Object.is(f,f));test.record(Object.is(s,s));test.record(Object.is(s,Symbol('s')));'ok';",

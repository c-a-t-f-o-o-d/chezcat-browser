    {
      "id": "object-is-builtin-descriptor",
      "source": "let d=Object.getOwnPropertyDescriptor(Object,'is');test.record(Object.is.name);test.record(Object.is.length);test.record(d.enumerable);test.record(d.writable);test.record(d.configurable);test.record(Object.is.call(null,NaN,NaN));'ok';",

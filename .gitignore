# Public source and reviewed project records are eligible by default.
# New root/document/data categories also require publication-policy review.
/*
**/.*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/Build.cmd
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CONTRIBUTORS.md
!/Cargo.lock
!/Cargo.toml
!/ENDORSED_BUILDS.md
!/HISTORY_IMPORT.md
!/LICENSE
!/LICENSE_SCOPE.md
!/README.md
!/Run.cmd
!/SECURITY.md
!/SOURCE_REVISION
!/THIRD_PARTY_NOTICES.md
!/build.rs
!/build_dev.cmd
!/rust-toolchain
!/rust-toolchain.toml
!/assets/
!/data/
!/notices/
!/pages/
!/resources/
!/src/
!/trust/

# Documentation and legal records.
!/docs/
/docs/*
!/docs/ARCHITECTURE.md
!/docs/BRANDING.md
!/docs/BUILDING.md
!/docs/CAPABILITIES.md
!/docs/COMPATIBILITY.md
!/docs/CONTRIBUTOR_PRIVACY.md
!/docs/ENDORSEMENT_POLICY.md
!/docs/FEATURE_CONTRACTS.md
!/docs/FEATURE_CONTRACTS_DETAIL.md
!/docs/HTML_FOUNDATION_COVERAGE.json
!/docs/HTML_FOUNDATION_PLAN.md
!/docs/LICENSE_ACCEPTANCE.md
!/docs/README.md
!/docs/RELEASING.md
!/docs/ROADMAP.md
!/docs/compatibility.json
!/licensing/
/licensing/*
!/licensing/CHANGES-1.1.md
!/licensing/CONTRIBUTOR_AGREEMENT.md

# Source checkers, original fixtures and pinned reference inputs.
!/tools/
/tools/*
!/tools/*.py
!/tools/*.rs
!/tools/compatibility_cases.json
!/tools/date_review_cases_040.json
!/tools/object_spread_review_cases_040.json
!/tools/operator_supplement_cases_041.json
!/tools/promise_cases.json
!/tools/review_bounds_040.json
!/tools/review_cases_040.json
!/tools/review_cases_041.json
!/tools/string_integration_review_cases_041.json
!/tools/demos/
!/tools/fixtures/
!/tools/https-demo/
!/tools/reference/

# Build and repository configuration.
!/.cargo/
/.cargo/*
!/.cargo/config
!/.cargo/config.toml
!/.github/
/.github/*
!/.github/pull_request_template.md
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
!/.github/workflows/*.yaml

# Generated files remain local within public source directories.
**/__pycache__/
*.pyc
*.pdb
**/*.rs.bk
**/target/
**/debug/
**/mutants.out*/
rustc-ice-*.txt
# Cargo.lock, generated icon resources and original fixtures stay tracked.
